NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/logistics_os
REDIS_URL=redis://localhost:6379
QUEUE_MODE=mock_enqueue_only
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_LOGIN_LIMIT=5
RATE_LIMIT_PASSWORD_RESET_LIMIT=3
RATE_LIMIT_AI_LIMIT=30
RATE_LIMIT_TRACKING_LIMIT=120
RATE_LIMIT_DOCUMENT_UPLOAD_LIMIT=30
RATE_LIMIT_PROVIDER_TEST_LIMIT=20
RATE_LIMIT_DRIVER_LOCATION_LIMIT=60
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret
JWT_SECRET=replace-with-local-jwt-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
S3_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=logistics-os
S3_ACCESS_KEY_ID=replace-with-local-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret
GPS_DELIVERY_TOLERANCE_METERS=150
AI_DEFAULT_PROVIDER_ID=
TEST_DATABASE_URL=postgresql://<test_db_user>:<test_db_password>@localhost:5432/logistics_os_test
PROVIDER_MODE=mock
PAYMENT_PROVIDER_MODE=mock
MAPS_PROVIDER_MODE=mock
MESSAGING_PROVIDER_MODE=mock
KYC_PROVIDER_MODE=mock
CARRIER_PROVIDER_MODE=mock
ERP_PROVIDER_MODE=mock
WEBHOOK_SIGNING_SECRET=replace-with-local-dev-secret
